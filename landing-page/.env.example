# Tanıtım sitesi backend'e istek atmaz; aşağıdaki adresler yalnızca bağlantı
# olarak gömülür. Üçü de derleme anında okunur (NEXT_PUBLIC_*): değiştirince
# yeniden deploy gerekir.

# Bu sitenin dinlediği port. SITE_URL'deki portla aynı olmalı.
PORT=3001

# Tanıtım sitesinin kanonik adresi (Open Graph, sitemap, robots)
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# x402 korumalı API (gateway). OpenAPI ve llms.txt bu kökten sunulur.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Canlı panel (app.mandate)
NEXT_PUBLIC_APP_URL=http://localhost:3002
