# Reinkey canlı paneli. Bu dosyayı .env.local olarak kopyalayıp doldurun.
# NEXT_PUBLIC_* değerleri derleme anında gömülür: değiştirince yeniden deploy gerekir.

# Bu uygulamanın dinlediği port.
PORT=3002

# x402 korumalı API (backend). Panel verisini buradan çeker.
# Üretim: https://reinkey.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:3000

# Tanıtım sitesi (logo / geri dön bağlantısı).
# DİKKAT: konsol reinkey.io'da, tanıtım sitesi reinkey.com'da yayında. Bu değer
# her zaman TANITIM SİTESİNİ gösterir; konsolun kendi adresi yazılırsa logo
# kullanıcıyı bulunduğu sayfaya geri atar.
# Şema ve www'yi tam yaz: çıplak reinkey.com, www'ye 308 ile yönleniyor ve
# http:// yazmak kullanıcıyı önce şifresiz bir sekmeden geçiriyor.
# Üretim: https://www.reinkey.com
NEXT_PUBLIC_SITE_URL=http://localhost:3001
