# Reinkey konsolu. Bu dosyayı .env.local olarak kopyalayıp doldurun.
# NEXT_PUBLIC_* değerleri derleme anında gömülür: değiştirince yeniden deploy gerekir.
#
# ADLANDIRMA: `NEXT_PUBLIC_SITE_URL` bu uygulamada YOKTUR ve olmamalıdır. O ad
# her uygulamada "uygulamanın kendi adresi" demektir; konsolun kendi adresine
# ihtiyacı yok. Buradaki adresler gittikleri servisin adıyla anılır.

# Bu uygulamanın dinlediği port.
PORT=3002

# x402 korumalı API (backend). Panel verisini buradan çeker.
# Üretim: https://reinkey.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:3000

# Tanıtım sitesi — depodaki `landing-page`, reinkey.com'da yayında.
# Kabuktaki logo ve bütün belge bağlantıları buraya gider; konsolun KENDİ
# adresi (reinkey.io) yazılırsa logo kullanıcıyı bulunduğu sayfaya geri atar.
# Şema ve www'yi tam yaz: çıplak reinkey.com, www'ye 308 ile yönleniyor ve
# http:// yazmak kullanıcıyı önce şifresiz bir sekmeden geçiriyor.
# Üretim: https://www.reinkey.com
# Eski ad `NEXT_PUBLIC_SITE_URL` de kabul edilir (Vercel'deki mevcut projeler için);
# ikisi de yoksa konsol açılır ama tanıtım sitesine giden bağlantılar çalışmaz.
NEXT_PUBLIC_MARKETING_URL=http://localhost:3001

# Stellar ağı: testnet (varsayılan) ya da public. Cüzdan ve explorer bağlantıları
# buna göre kurulur; backend'in STELLAR_NETWORK_PASSPHRASE değeriyle aynı ağ olmalı.
NEXT_PUBLIC_STELLAR_NETWORK=testnet
