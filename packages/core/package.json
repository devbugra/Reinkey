{
  "name": "@reinkey/core",
  "version": "0.1.0",
  "type": "module",
  "description": "Reinkey protocol core: voucher encoding and signing, reason codes, shared types",
  "license": "MIT",
  "keywords": [
    "reinkey",
    "x402",
    "stellar",
    "soroban",
    "payment-channel",
    "voucher"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reinkey/reinkey.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
