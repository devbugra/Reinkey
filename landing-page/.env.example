# Tanıtım sitesi backend'e istek atmaz; aşağıdaki adresler yalnızca bağlantı
# olarak gömülür. Üçü de derleme anında okunur (NEXT_PUBLIC_*): değiştirince
# yeniden deploy gerekir.

# Bu sitenin dinlediği port. SITE_URL'deki portla aynı olmalı.
PORT=3001

# Tanıtım sitesinin kanonik adresi (Open Graph, sitemap, robots, hreflang).
# Şema ve www ile tam yazılmalı: çıplak reinkey.com www'ye 308 ile yönleniyor,
# dolayısıyla kanonik ana bilgisayar adı www'dür. Eksik yazılırsa arama
# motorları http:// ve çıplak alan adını kanonik sanır.
# Üretim: https://www.reinkey.com
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# x402 korumalı API (gateway). OpenAPI ve llms.txt bu kökten sunulur.
# Üretim: https://reinkey.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:3000

# Canlı panel (app.mandate). Konsol ayrı bir alan adında yayında.
# Üretim: https://www.reinkey.io
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Üretim derlemesi (NODE_ENV=production) yukarıdakilerden biri hâlâ localhost
# ise DURUR: yanlış adrese giden bağlantılar fark edilmeden canlıya çıkıyor.
# Yalnızca yerel bir üretim derlemesini denemek için bilerek açın.
# ALLOW_LOCALHOST_URLS=1
