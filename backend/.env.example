PORT=3000
PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
DATABASE_URL=postgresql://postgres:PAROLA@localhost:5432/mandate_db

# Zincir erişimi: "mock" (bellek içi, kontratlar hazır olmadan) | "stellar" (gerçek testnet)
CHAIN_MODE=mock
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
X402_NETWORK=stellar:testnet

# Kontrat kimlikleri: Hat 1, deploy sonrası ../deployments/testnet.json dosyasına yazar
CHANNEL_CONTRACT_ID=
USDC_CONTRACT_ID=

# Facilitator'ın G-hesabı: claim işlemlerinin kaynağı ve ücret ödeyeni
FACILITATOR_SECRET=

# Demo satıcının ödeme adresi (kanalın payee'si). G... ya da C...
SELLER_PAY_TO=

# Tahsilat politikası
CLAIM_THRESHOLD=1000000          # 0.1 USDC (taban birim, 7 ondalık)
CLAIM_INTERVAL_SECONDS=30
CLAIM_EXPIRY_MARGIN_LEDGERS=120  # süre dolmasına bu kadar ledger kala mutlaka claim et
VOUCHER_EXPIRY_SAFETY_LEDGERS=60 # süre dolmasına bundan az kalan kanalın kuponu reddedilir

# Kanal başına dakikadaki çağrı sınırı (0 = kapalı)
RATE_LIMIT_PER_MINUTE=1200

# Demo fiyatları (taban birim)
PRICE_BOOK_PER_REQUEST=5000      # 0.0005 USDC
PRICE_CHAT_PER_TOKEN=200         # 0.00002 USDC
CHAT_SLICE_TOKENS=50

# /demo/chat: gerçek LLM modu için. Boşsa yedek (hazır metin) modu çalışır.
ANTHROPIC_API_KEY=
# Anahtar bir workspace'e bağlı değilse (organizasyon anahtarı) zorunlu: console.anthropic.com → Settings → Workspaces (wrkspc_…)
ANTHROPIC_WORKSPACE_ID=
CHAT_MODEL=claude-haiku-4-5-20251001
CHAT_MODE=fallback               # fallback | llm  (sahnede varsayılan: fallback)

# v4: saniye başı fiyat akışı (gerçek fiyat: Soroswap havuz rezervleri)
PRICE_TICKER_PER_SECOND=1000     # 0.0001 USDC / saniye
TICKER_SLICE_SECONDS=1           # kupon başına ödenen saniye (demo: 1 → "90 saniye, 90 ödeme")

# DEX katmanı. Boş bırakılırsa ../deployments/testnet.json'dan okunur.
XLM_CONTRACT_ID=
DEX_PAIR_ID=
DEX_ROUTER_ID=

# Demo kontrolleri (konsoldaki "Ajanı başlat", "Ele geçirilmiş ajan", "Dondur").
# true ise AGENT_OWNER_SECRET zorunlu (dondurma işlemini imzalar). Jüri URL'sinde açık, sonra kapat.
DEMO_CONTROLS=false
DEMO_ACCOUNT_ID=                 # boşsa deployments/testnet.json → demoAccountId
AGENT_OWNER_SECRET=
AGENTS_DIR=../agents             # ajan betikleri; Docker imajında /app/agents

# Reinkey Float (kredi havuzu). Boş bırakılırsa ../deployments/testnet.json'dan okunur; o da yoksa Float kapalı.
CREDIT_POOL_ID=
CREDIT_ACCOUNT_IDS=              # havuzdan hat açılmış Reinkey hesapları, virgülle
FLOAT_INVESTORS=                 # pozisyonu gösterilecek yatırımcı adresleri, virgülle

# Açık deploy kimliklerinin dosyası (kontrat ve hesap adresleri)
DEPLOYMENT_FILE=../deployments/testnet.json

# Herkese açık uçlarda IP başına dakikalık istek sınırı (0 = kapalı).
# "costly": sunucuya zincir ücreti ödeten ya da kayıt yazan POST uçları.
IP_RATE_LIMIT_PER_MINUTE=3000
IP_COSTLY_LIMIT_PER_MINUTE=30

# Panelden ajan başlatma ve dondurma için gizli anahtar. Tanımlıysa bu uçlar
# `x-demo-key` başlığı ister; jüri bağlantısına ?key=… eklenir. Tanımsızsa
# DEMO_CONTROLS=true iken uçlar HERKESE AÇIKTIR (açılışta uyarı verilir).
DEMO_CONTROL_KEY=
