{
  "name": "@reinkey/meter",
  "version": "0.1.0",
  "type": "module",
  "description": "Reinkey Meter — usage-based billing middleware: sell any API per request, per token or per second over x402 on Stellar",
  "license": "MIT",
  "keywords": [
    "reinkey",
    "reinkey-meter",
    "x402",
    "stellar",
    "express",
    "middleware",
    "usage-based-billing",
    "metering",
    "micropayments",
    "payment-channel"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devbugra/Reinkey.git",
    "directory": "packages/meter"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
